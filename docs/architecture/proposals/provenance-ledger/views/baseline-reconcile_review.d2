_view_title: "Current review reconciliation scenario" {
  shape: text
}

_scenario_context: "Scenario: Reconcile pull-request review" {
  class: evidence_supported
  tooltip: "Trigger: A pull request or review cycle needs current readiness.\nPreconditions: PR identity and head SHA resolve.; Review control ref is writable.\nControls: pr_number; head_sha; review_id\nOutputs: Durable review cycle and readiness state.\nFailures: Head mismatch leaves review stale.; Missing validation blocks readiness.; Control-ref conflict preserves prior state.\nSignals: Review ledger event.; Stale-head marker.; Readiness decision."
}

