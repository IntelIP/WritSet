      stroke-dash: 4
      border-radius: 6
    }
  }
  evidence_unknown: {
    style: {
      fill: "#F5F5F5"
      stroke: "#555555"
      stroke-dash: 2
      border-radius: 6
    }
  }
  evidence_conflicted: {
    style: {
      fill: "#FFEBEE"
      stroke: "#B71C1C"
      stroke-width: 3
      border-radius: 6
    }
  }
}

