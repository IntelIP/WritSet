# Generated from target.yaml. Edit YAML or assets/d2-style.d2, then regenerate.
direction: right
classes: {
  evidence_supported: {
    style: {
      fill: "#E8F5E9"
      stroke: "#1B5E20"
      border-radius: 6
    }
  }
  evidence_inferred: {
    style: {
      fill: "#FFF8E1"
      stroke: "#7A5A00"
      stroke-dash: 4
      border-radius: 6
    }
  }
  evidence_proposed: {
    style: {
      fill: "#E3F2FD"
      stroke: "#0D47A1"
      stroke-dash: 4
      border-radius: 6
    }
  }
  evidence_unknown: {
    style: {
      fill: "#F5F5F5"
      stroke: "#555555"
      stroke-dash: 2
      border-radius: 6
    }
  }
  evidence_conflicted: {
    style: {
      fill: "#FFEBEE"
      stroke: "#B71C1C"
      stroke-width: 3
      border-radius: 6
    }
  }
}

_view_title: "Target context and evidence path" {
  shape: text
}

agent_runtime: "Agent runtime\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: agent_runtime\nResponsibility: Produce model decisions, tool calls, edits, and bounded outputs.\nOwner: Agent runtime operator\nRuntime: Codex or compatible agent\nState variables: run_id; trace_id; tool_call_id\nInvariants: Runtime events carry source identity and run identity.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/external_document: https://developers.openai.com/api/docs/guides/agents/integrations-observability @ current-2026-08-30"
  link: "https://developers.openai.com/api/docs/guides/agents/integrations-observability"
}

source_adapters: "Source adapters\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: source_adapters\nResponsibility: Translate provider records into bounded canonical events.\nOwner: Tabellio maintainers\nRuntime: Node.js worker\nState variables: source_event_id; adapter_version; idempotency_key\nInvariants: Provider-specific differences do not change canonical identity fields.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/architecture-diagrams.md:1#Tabellio System Architecture Diagrams @ 979a81d07994f8024c3b071581165de94685d2ca"
}

ingest_worker: "Ingest worker\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: ingest_worker\nResponsibility: Accept events, enforce idempotency, and coordinate canonical persistence.\nOwner: Tabellio maintainers\nRuntime: Node.js worker\nState variables: event_id; ingest_status; payload_digest\nInvariants: A retry does not create duplicate evidence.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/architecture-diagrams.md:1#Tabellio System Architecture Diagrams @ 979a81d07994f8024c3b071581165de94685d2ca"
}

canonicalizer: "Redaction and canonicalizer\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: canonicalizer\nResponsibility: Redact secrets, classify sensitivity, canonicalize payloads, and compute digests.\nOwner: Security and Tabellio maintainers\nRuntime: Node.js worker\nState variables: redaction_status; sensitivity; payload_sha256\nInvariants: Secrets are blocked before durable persistence.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca"
}

provenance_ledger: "PostgreSQL provenance ledger\n[proposed]" {
  class: evidence_proposed
  shape: cylinder
  tooltip: "ID: provenance_ledger\nResponsibility: Store typed facts, JSONB payloads, stable identities, and critical relationships.\nOwner: Tabellio maintainers\nRuntime: PostgreSQL\nState variables: run_id; event_id; repository_id; commit_sha; checkpoint_id\nInvariants: Critical references satisfy relational constraints.; Facts are append-only or dispositioned.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/external_document: https://www.postgresql.org/docs/current/datatype-json.html @ PostgreSQL 18 current documentation; intended/external_document: https://www.postgresql.org/docs/current/ddl-constraints.html @ PostgreSQL 18 current documentation; intended/external_document: https://www.postgresql.org/docs/current/queries-with.html @ PostgreSQL 18 current documentation"
  link: "https://www.postgresql.org/docs/current/datatype-json.html"
}

projection_worker: "Correlation projector\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: projection_worker\nResponsibility: Build lineage, stack, review, freshness, and query projections from immutable facts.\nOwner: Tabellio maintainers\nRuntime: Node.js worker\nState variables: projection_revision; source_event_id; lag\nInvariants: Projections can be rebuilt from the ledger.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/architecture-diagrams.md:1#Tabellio System Architecture Diagrams @ 979a81d07994f8024c3b071581165de94685d2ca; intended/external_document: https://www.postgresql.org/docs/current/queries-with.html @ PostgreSQL 18 current documentation"
  link: "https://www.postgresql.org/docs/current/queries-with.html"
}

read_model: "Operational read model\n[proposed]" {
  class: evidence_proposed
  shape: cylinder
  tooltip: "ID: read_model\nResponsibility: Serve current lineage, stack, review, and exact-head freshness queries.\nOwner: Tabellio maintainers\nRuntime: PostgreSQL read projection\nState variables: head_sha; review_status; projection_revision\nInvariants: A projection never authorizes a head different from its assessed head.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/architecture-diagrams.md:1#Tabellio System Architecture Diagrams @ 979a81d07994f8024c3b071581165de94685d2ca"
}

context_broker: "Scoped context broker\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: context_broker\nResponsibility: Return bounded project-specific evidence and lessons to a review or agent run.\nOwner: Tabellio maintainers\nRuntime: Read-only Node.js API or MCP tool\nState variables: request_scope; head_sha; packet_digest; access_decision\nInvariants: Context is scoped to the requester, project, repository, and exact head.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/architecture-diagrams.md:1#Tabellio System Architecture Diagrams @ 979a81d07994f8024c3b071581165de94685d2ca"
}

codex_review: "Codex review consumer\n[inferred]" {
  class: evidence_inferred
  shape: rectangle
  tooltip: "ID: codex_review\nResponsibility: Interpret bounded evidence, identify risks, and propose review findings.\nOwner: Review operator\nRuntime: Codex or compatible agent\nState variables: review_id; head_sha; finding_ids\nInvariants: Codex review does not replace deterministic gates or human approval.\nEvidence: implemented/source_code: scripts/tabellio-review.mjs:1#review command @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/external_document: https://developers.openai.com/api/docs/guides/agents/integrations-observability @ current-2026-08-30"
  link: "https://developers.openai.com/api/docs/guides/agents/integrations-observability"
}

agent_runtime -> source_adapters: "Agent trace event / trace export or bounded event API\n[proposed]" {
  style: {
    stroke: "#0D47A1"
    stroke-width: 2
    stroke-dash: 4
  }
  tooltip: "ID: agent_to_adapters\nRelationship: publishes\nContract: agent event envelope\nAuthentication: runtime identity and signed request\nMode: async\nTimeout: 10s\nRetries: exponential retry up to 5\nIdempotency: trace_id plus tool_call_id plus payload_digest\nFallback: local encrypted spool\nFailure propagation: event is marked unavailable\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/external_document: https://developers.openai.com/api/docs/guides/agents/integrations-observability @ current-2026-08-30"
  link: "https://developers.openai.com/api/docs/guides/agents/integrations-observability"
}

