  style: {
    stroke: "#1B5E20"
    stroke-width: 2
  }
  tooltip: "ID: validator_to_validation_ref\nRelationship: writes\nContract: tabellio validation result\nAuthentication: approval-bound ref transport\nMode: sync\nTimeout: 30s\nRetries: none\nIdempotency: validation_id plus assessed_commit\nFallback: retain local result\nFailure propagation: readiness remains blocked\nEvidence: implemented/source_code: scripts/tabellio-validator.mjs:1#validation command @ 979a81d07994f8024c3b071581165de94685d2ca; implemented/source_code: scripts/lib/control-ref-transport.mjs:1#control-ref transport @ 979a81d07994f8024c3b071581165de94685d2ca"
}

