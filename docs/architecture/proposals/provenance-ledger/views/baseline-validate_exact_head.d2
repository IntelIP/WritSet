direction: right
classes: {
  evidence_supported: {
    style: {
      fill: "#E8F5E9"
      stroke: "#1B5E20"
      border-radius: 6
    }
  }
  evidence_inferred: {
    style: {
      fill: "#FFF8E1"
      stroke: "#7A5A00"
      stroke-dash: 4
      border-radius: 6
    }
  }
  evidence_proposed: {
    style: {
      fill: "#E3F2FD"
      stroke: "#0D47A1"
      stroke-dash: 4
      border-radius: 6
    }
  }
  evidence_unknown: {
    style: {
      fill: "#F5F5F5"
      stroke: "#555555"
      stroke-dash: 2
      border-radius: 6
    }
  }
  evidence_conflicted: {
    style: {
      fill: "#FFEBEE"
      stroke: "#B71C1C"
      stroke-width: 3
      border-radius: 6
    }
  }
}

_view_title: "Current exact-head validation scenario" {
  shape: text
}

_scenario_context: "Scenario: Validate an exact commit" {
  class: evidence_supported
  tooltip: "Trigger: A candidate commit is ready for validation.\nPreconditions: Manifest is committed.; Trusted worker is available.\nControls: commit_sha; manifest_digest; validation_id\nOutputs: Durable validation decision tied to commit and manifest.\nFailures: Worker failure.; Stale or non-fast-forward publication.; Validation fails.\nSignals: Validation result ref.; Command statuses.; Manifest digest."
}

tabellio_cli: "Tabellio Node CLI\n[supported]" {
  class: evidence_supported
  shape: rectangle
  tooltip: "ID: tabellio_cli\nResponsibility: Orchestrate the Git-native agent workflow and evidence contracts.\nOwner: Tabellio maintainers\nRuntime: Node.js\nState variables: run_id; worktree; head_sha\nInvariants: Run state is bound to an exact repository and revision.\nEvidence: intended/design_document: docs/workflow-model.md:1#Tabellio Workflow Model @ 979a81d07994f8024c3b071581165de94685d2ca; implemented/source_code: scripts/capture-tabellio-context.mjs:1#context capture @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/tooling-stack.md:1#Agentic Tooling Stack @ 979a81d07994f8024c3b071581165de94685d2ca"
}

validation_worker: "Validation worker\n[supported]" {
  class: evidence_supported
  shape: rectangle
  tooltip: "ID: validation_worker\nResponsibility: Run committed validation manifests against an exact revision.\nOwner: Operator-managed worker\nRuntime: Node.js and repository tools\nState variables: validation_id; revision; decision\nInvariants: Validation is bound to the assessed commit and manifest.\nEvidence: implemented/source_code: scripts/tabellio-validator.mjs:1#validation command @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/validation-runner.md:1#Validation runner @ 979a81d07994f8024c3b071581165de94685d2ca"
}

validation_ref: "Validation result ref\n[supported]" {
  class: evidence_supported
  shape: cylinder
  tooltip: "ID: validation_ref\nResponsibility: Publish durable exact-head validation results.\nOwner: Tabellio maintainers\nRuntime: Git ref\nState variables: commit_sha; manifest_digest; decision\nInvariants: Non-fast-forward or stale publication is rejected.\nEvidence: implemented/source_code: scripts/tabellio-validator.mjs:1#validation command @ 979a81d07994f8024c3b071581165de94685d2ca; implemented/source_code: scripts/lib/control-ref-transport.mjs:1#control-ref transport @ 979a81d07994f8024c3b071581165de94685d2ca"
}

tabellio_cli -> validation_worker: "1. Run exact-commit validation / argv manifest\n[supported]" {
  style: {
    stroke: "#1B5E20"
    stroke-width: 2
  }
  tooltip: "ID: cli_to_validator\nRelationship: calls\nContract: tabellio validation manifest\nAuthentication: worker identity\nMode: sync\nTimeout: bounded by worker policy\nRetries: none\nIdempotency: repository plus commit plus manifest_digest\nFallback: decision blocked\nFailure propagation: validation is failed or unavailable\nEvidence: implemented/source_code: scripts/tabellio-validator.mjs:1#validation command @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/validation-runner.md:1#Validation runner @ 979a81d07994f8024c3b071581165de94685d2ca"
}

