source_adapters: "Source adapters\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: source_adapters\nResponsibility: Translate provider records into bounded canonical events.\nOwner: Tabellio maintainers\nRuntime: Node.js worker\nState variables: source_event_id; adapter_version; idempotency_key\nInvariants: Provider-specific differences do not change canonical identity fields.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/architecture-diagrams.md:1#Tabellio System Architecture Diagrams @ 979a81d07994f8024c3b071581165de94685d2ca"
}

canonicalizer: "Redaction and canonicalizer\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: canonicalizer\nResponsibility: Redact secrets, classify sensitivity, canonicalize payloads, and compute digests.\nOwner: Security and Tabellio maintainers\nRuntime: Node.js worker\nState variables: redaction_status; sensitivity; payload_sha256\nInvariants: Secrets are blocked before durable persistence.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca"
}

provenance_ledger: "PostgreSQL provenance ledger\n[proposed]" {
  class: evidence_proposed
  shape: cylinder
  tooltip: "ID: provenance_ledger\nResponsibility: Store typed facts, JSONB payloads, stable identities, and critical relationships.\nOwner: Tabellio maintainers\nRuntime: PostgreSQL\nState variables: run_id; event_id; repository_id; commit_sha; checkpoint_id\nInvariants: Critical references satisfy relational constraints.; Facts are append-only or dispositioned.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/external_document: https://www.postgresql.org/docs/current/datatype-json.html @ PostgreSQL 18 current documentation; intended/external_document: https://www.postgresql.org/docs/current/ddl-constraints.html @ PostgreSQL 18 current documentation; intended/external_document: https://www.postgresql.org/docs/current/queries-with.html @ PostgreSQL 18 current documentation"
  link: "https://www.postgresql.org/docs/current/datatype-json.html"
}

artifact_store: "Private artifact store\n[proposed]" {
  class: evidence_proposed
  shape: cylinder
  tooltip: "ID: artifact_store\nResponsibility: Store large logs, diffs, traces, and transcripts behind access control.\nOwner: Platform operator\nRuntime: Content-addressed object storage\nState variables: artifact_sha256; uri; sensitivity; retention_class\nInvariants: Digest and access policy remain attached to every artifact.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/architecture-diagrams.md:1#Tabellio System Architecture Diagrams @ 979a81d07994f8024c3b071581165de94685d2ca"
}

