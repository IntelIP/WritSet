  style: {
    stroke: "#0D47A1"
    stroke-width: 2
    stroke-dash: 4
  }
  tooltip: "ID: task_to_adapters\nRelationship: publishes\nContract: task event envelope\nAuthentication: scoped task-source credential\nMode: async\nTimeout: 10s\nRetries: exponential retry up to 5\nIdempotency: source_event_id plus task_ref\nFallback: durable source retry or operator queue\nFailure propagation: run remains un-ingested\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca"
}

