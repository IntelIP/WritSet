_legend: "Evidence state" {
  direction: right
  style: {
    fill: "#FFFFFF"
    stroke: "#9CA3AF"
  }
  supported: "Supported" {
    class: evidence_supported
  }
  inferred: "Inferred" {
    class: evidence_inferred
  }
  proposed: "Proposed" {
    class: evidence_proposed
  }
  unknown: "Unknown" {
