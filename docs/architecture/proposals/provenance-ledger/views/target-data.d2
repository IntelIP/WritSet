direction: right
classes: {
  evidence_supported: {
    style: {
      fill: "#E8F5E9"
      stroke: "#1B5E20"
      border-radius: 6
    }
  }
  evidence_inferred: {
    style: {
      fill: "#FFF8E1"
      stroke: "#7A5A00"
      stroke-dash: 4
      border-radius: 6
    }
  }
  evidence_proposed: {
    style: {
      fill: "#E3F2FD"
      stroke: "#0D47A1"
      stroke-dash: 4
      border-radius: 6
    }
  }
  evidence_unknown: {
    style: {
      fill: "#F5F5F5"
      stroke: "#555555"
      stroke-dash: 2
      border-radius: 6
    }
  }
  evidence_conflicted: {
    style: {
      fill: "#FFEBEE"
      stroke: "#B71C1C"
      stroke-width: 3
      border-radius: 6
    }
  }
}

_view_title: "Target data and projection boundaries" {
  shape: text
}

event_bus: "Event queue\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: event_bus\nResponsibility: Buffer canonical events and provide retry/backpressure behavior.\nOwner: Platform operator\nRuntime: Managed queue or durable local queue\nState variables: event_id; delivery_count; dead_letter_state\nInvariants: Delivery is at-least-once and consumers are idempotent.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca"
}

ingest_worker: "Ingest worker\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: ingest_worker\nResponsibility: Accept events, enforce idempotency, and coordinate canonical persistence.\nOwner: Tabellio maintainers\nRuntime: Node.js worker\nState variables: event_id; ingest_status; payload_digest\nInvariants: A retry does not create duplicate evidence.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/architecture-diagrams.md:1#Tabellio System Architecture Diagrams @ 979a81d07994f8024c3b071581165de94685d2ca"
}

canonicalizer: "Redaction and canonicalizer\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: canonicalizer\nResponsibility: Redact secrets, classify sensitivity, canonicalize payloads, and compute digests.\nOwner: Security and Tabellio maintainers\nRuntime: Node.js worker\nState variables: redaction_status; sensitivity; payload_sha256\nInvariants: Secrets are blocked before durable persistence.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca"
}

provenance_ledger: "PostgreSQL provenance ledger\n[proposed]" {
  class: evidence_proposed
  shape: cylinder
  tooltip: "ID: provenance_ledger\nResponsibility: Store typed facts, JSONB payloads, stable identities, and critical relationships.\nOwner: Tabellio maintainers\nRuntime: PostgreSQL\nState variables: run_id; event_id; repository_id; commit_sha; checkpoint_id\nInvariants: Critical references satisfy relational constraints.; Facts are append-only or dispositioned.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/external_document: https://www.postgresql.org/docs/current/datatype-json.html @ PostgreSQL 18 current documentation; intended/external_document: https://www.postgresql.org/docs/current/ddl-constraints.html @ PostgreSQL 18 current documentation; intended/external_document: https://www.postgresql.org/docs/current/queries-with.html @ PostgreSQL 18 current documentation"
  link: "https://www.postgresql.org/docs/current/datatype-json.html"
}

artifact_store: "Private artifact store\n[proposed]" {
  class: evidence_proposed
  shape: cylinder
  tooltip: "ID: artifact_store\nResponsibility: Store large logs, diffs, traces, and transcripts behind access control.\nOwner: Platform operator\nRuntime: Content-addressed object storage\nState variables: artifact_sha256; uri; sensitivity; retention_class\nInvariants: Digest and access policy remain attached to every artifact.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/architecture-diagrams.md:1#Tabellio System Architecture Diagrams @ 979a81d07994f8024c3b071581165de94685d2ca"
}

projection_worker: "Correlation projector\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: projection_worker\nResponsibility: Build lineage, stack, review, freshness, and query projections from immutable facts.\nOwner: Tabellio maintainers\nRuntime: Node.js worker\nState variables: projection_revision; source_event_id; lag\nInvariants: Projections can be rebuilt from the ledger.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/architecture-diagrams.md:1#Tabellio System Architecture Diagrams @ 979a81d07994f8024c3b071581165de94685d2ca; intended/external_document: https://www.postgresql.org/docs/current/queries-with.html @ PostgreSQL 18 current documentation"
  link: "https://www.postgresql.org/docs/current/queries-with.html"
}

read_model: "Operational read model\n[proposed]" {
  class: evidence_proposed
  shape: cylinder
  tooltip: "ID: read_model\nResponsibility: Serve current lineage, stack, review, and exact-head freshness queries.\nOwner: Tabellio maintainers\nRuntime: PostgreSQL read projection\nState variables: head_sha; review_status; projection_revision\nInvariants: A projection never authorizes a head different from its assessed head.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/architecture-diagrams.md:1#Tabellio System Architecture Diagrams @ 979a81d07994f8024c3b071581165de94685d2ca"
}

evaluation_worker: "Evaluation and lesson worker\n[proposed]" {
  class: evidence_proposed
  shape: rectangle
  tooltip: "ID: evaluation_worker\nResponsibility: Replay cases, compare behavior, and create scoped candidate lessons.\nOwner: Tabellio maintainers and evaluation owner\nRuntime: Node.js worker and evaluation harness\nState variables: case_id; baseline_version; candidate_version; outcome\nInvariants: Lessons require evidence references and versioned outcomes.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/external_document: https://developers.openai.com/api/docs/guides/agent-evals @ current-2026-08-30"
  link: "https://developers.openai.com/api/docs/guides/agent-evals"
}

lesson_store: "Scoped lesson store\n[proposed]" {
  class: evidence_proposed
  shape: cylinder
  tooltip: "ID: lesson_store\nResponsibility: Store versioned project, organization, and general lessons with evidence links.\nOwner: Tabellio maintainers\nRuntime: PostgreSQL projection\nState variables: lesson_id; scope; status; version; evidence_refs\nInvariants: Candidate lessons do not silently change global behavior.\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca; intended/external_document: https://developers.openai.com/api/docs/guides/agent-evals @ current-2026-08-30"
  link: "https://developers.openai.com/api/docs/guides/agent-evals"
}

event_bus -> ingest_worker: "Deliver canonical event / queue consumer\n[proposed]" {
  style: {
    stroke: "#0D47A1"
    stroke-width: 2
    stroke-dash: 4
  }
  tooltip: "ID: bus_to_ingest\nRelationship: subscribes\nContract: tabellio provenance event/v1\nAuthentication: consumer workload identity\nMode: async\nTimeout: 30s\nRetries: exponential retry up to 5\nIdempotency: event_id plus payload_digest\nFallback: dead-letter queue\nFailure propagation: projection and context data lag\nEvidence: intended/design_document: docs/agent-provenance-ledger-and-codex-feedback.md:1#Agent Provenance Ledger and Codex Feedback Plan @ 979a81d07994f8024c3b071581165de94685d2ca"
}

