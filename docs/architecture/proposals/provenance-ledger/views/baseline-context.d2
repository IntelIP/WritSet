  class: evidence_supported
  shape: cylinder
  tooltip: "ID: git_store\nResponsibility: Store commits, refs, diffs, branches, and isolated worktrees.\nOwner: Repository operator\nRuntime: Git\nState variables: commit_sha; ref; worktree\nInvariants: Commit IDs are immutable.\nEvidence: implemented/source_code: scripts/capture-tabellio-context.mjs:1#context capture @ 979a81d07994f8024c3b071581165de94685d2ca; intended/design_document: docs/tooling-stack.md:1#Agentic Tooling Stack @ 979a81d07994f8024c3b071581165de94685d2ca"
}

